{
  "manifest_version": 3,
  "name": "YGN Dueling Book Helper",
  "version": "1.0.0",
  "description": "1-Click RFC 0001 (YGN / YBN) algebraic match export directly inside Dueling Book duels and replays.",
  "author": "Haunted Labs & Yu-Gi-Oh! Open Tooling Working Group",
  "homepage_url": "https://niloedson.github.io/projects/ygn-standard.html",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YGN Dueling Book Helper",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.duelingbook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "clipboardWrite"
  ]
}
